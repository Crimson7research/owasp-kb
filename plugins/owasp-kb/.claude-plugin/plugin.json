{
  "name": "owasp-kb",
  "version": "0.14.0",
  "description": "Authoritative OWASP security guidance (ASVS 5.0.0 + Cheat Sheet Series) and MITRE's CWE catalogue (4.20, not an OWASP project) via a local MCP server, with skills for secure coding, ASVS verification, gap reporting and threat modelling",
  "author": {
    "name": "Yimura"
  },
  "repository": "https://github.com/Yimura/owasp-kb",
  "license": "MIT",
  "keywords": [
    "security",
    "owasp",
    "asvs",
    "cwe",
    "mitre",
    "appsec",
    "secure-coding",
    "threat-modeling"
  ],
  "mcpServers": "./.mcp.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/block_excluded_reads.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
